{
  "version": 1,
  "sites": [
    {
      "$id": "lyrenthos-browser",
      "name": "Lyrenthos Browser",
      "enabled": true,
      "logging": true,
      "framework": "vite",
      "timeout": 30,
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "buildRuntime": "node-22",
      "adapter": "static",
      "fallbackFile": "index.html",
      "path": ".",
      "deploymentRetention": 7
    }
  ],
  "functions": [
    {
      "$id": "lyrenthos-gateway",
      "name": "Lyrenthos Gateway",
      "enabled": true,
      "logging": true,
      "runtime": "node-22",
      "entrypoint": "index.js",
      "commands": "npm install",
      "execute": ["any"],
      "events": [],
      "schedule": "",
      "timeout": 30,
      "path": "functions/lyrenthos-gateway",
      "scopes": [
        "buckets.read",
        "buckets.write",
        "files.read",
        "files.write"
      ],
      "deploymentRetention": 7
    }
  ]
}
