{
  "version": 1,
  "sites": [
    {
      "$id": "lyrenthos-browser",
      "name": "Lyrenthos Browser",
      "enabled": true,
      "logging": true,
      "framework": "vite",
      "timeout": 30,
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "buildRuntime": "node-22",
      "adapter": "static",
      "fallbackFile": "index.html",
      "path": "apps/web",
      "deploymentRetention": 7
    }
  ]
}
